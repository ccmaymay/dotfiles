conky.config = {
    background = true,
    draw_borders = true,
    -- draw_outline = true,
    own_window = true,
    own_window_type = 'dock', -- normal, panel, dock
    own_window_hints = 'undecorated,above,sticky',  -- skip_taskbar,skip_pager
    -- own_window_transparent = true,
    own_window_colour = '200600',
    own_window_argb_visual = true,
    own_window_argb_value = 220,
    alignment = 'top_middle',
    gap_x = -35,
    gap_y = 80,
    update_interval=1,
    minimum_height=50,
    minimum_width=160,
    text_buffer_size=556,
    default_color='FFC0BA',
    font = 'DejaVu Sans Mono:size=16',
    use_xft = true,
    double_buffer = true,
    border_inner_margin = 40,
}

conky.text = [[
${alignc}\
${font DejaVu Sans:size=60}${time %-I:%M}\

${font DejaVu Sans:size=40}Time for a break!
]]
